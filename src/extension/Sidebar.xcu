<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data oor:package="org.openoffice.Office.UI" oor:name="Sidebar"
                    xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="LoAIDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="ru-RU">AI-ассистент</value>
          <value xml:lang="en-US">AI Assistant</value>
          <value xml:lang="zh-CN">AI 助手</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>LoAIDeck</value>
        </prop>
        <prop oor:name="IconURL" oor:type="xs:string">
          <value>vnd.sun.star.expand:%origin%/icons/ai_26.png</value>
        </prop>
        <prop oor:name="ContextList" oor:type="oor:string-list">
          <value>any, any, visible</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>250</value>
        </prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="LoAIPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="ru-RU">AI-ассистент</value>
          <value xml:lang="en-US">AI Assistant</value>
          <value xml:lang="zh-CN">AI 助手</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>LoAIPanel</value>
        </prop>
        <prop oor:name="DeckId" oor:type="xs:string">
          <value>LoAIDeck</value>
        </prop>
        <prop oor:name="ContextList" oor:type="oor:string-list">
          <value>any, any, visible</value>
        </prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string">
          <value>private:resource/loai/panel</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>100</value>
        </prop>
        <prop oor:name="WantsAWT" oor:type="xs:boolean">
          <value>false</value>
        </prop>
      </node>
    </node>
  </node>
</oor:component-data>
